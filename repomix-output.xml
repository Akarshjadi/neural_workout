        blurt: blurt,
        allScores: [blurt],
        sessions: [],
        linkCountForNote: 3,
        totalNotes: 10,
      );
      expect(result.recallAccuracy, 75);
    });

    test('computes cross-link density', () {
      final blurt = BlurtScore(
        id: 1,
        noteId: 1,
        noteTitle: 'Test',
        date: DateTime.now(),
        scorePct: 50,
        matched: [],
        missed: [],
