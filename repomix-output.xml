        depthScore: 70,
        clarityScore: 85,
      );
      expect(r.depthScore, 70);
      expect(r.clarityScore, 85);
    });

    test('creates ScoreResult without AI fields (fallback)', () {
      final r = ScoreResult(
        scorePct: 60,
        matched: ['a'],
        missed: ['b'],
        sourceConcepts: ['a', 'b'],
      );
