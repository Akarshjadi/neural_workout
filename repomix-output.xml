import 'package:flutter/material.dart';
import '../../models/note.dart';
import '../../ui/theme_notebook.dart';

class MemoryHorizon extends StatefulWidget {
  final List<Note> notes;
  final ValueChanged<Note>? onNoteSelected;
  final double height;

  const MemoryHorizon({
    super.key,
    required this.notes,
    this.onNoteSelected,
    this.height = 140,
  });

  @override
  State<MemoryHorizon> createState() => _HorizonState();
}

class _HorizonState extends State<MemoryHorizon> {
  Note? _sel;

  @override
  Widget build(BuildContext context) {
    final now = DateTime.now();
    final bands = <List<Note>>[[], [], [], []]; // Due/Now, Near (1-3d), Mid (4-14d), Long (15d+)

    for (final n in widget.notes) {
      final d = n.card.due.difference(now).inDays;
      if (d <= 0) {
        bands[0].add(n);
      } else if (d <= 3) {
        bands[1].add(n);
      } else if (d <= 14) {
        bands[2].add(n);
      } else {
        bands[3].add(n);
      }
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      mainAxisSize: MainAxisSize.min,
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text('MEMORY HORIZON', style: Theme.of(context).textTheme.labelSmall),
            Text('FSRS TEMPORAL FIELD', style: Theme.of(context).textTheme.labelSmall?.copyWith(fontSize: 8)),
          ],
        ),
        const SizedBox(height: 6),
        Container(
          height: widget.height,
          padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 4),
          decoration: BoxDecoration(border: Border.all(color: NotebookTheme.graphite.withValues(alpha: 0.2))),
          child: CustomPaint(
            painter: _HorizonPainter(bands, _sel),
            child: GestureDetector(
              onTapUp: (d) {
                final r = (d.localPosition.dy / (widget.height / 4)).floor().clamp(0, 3);
                if (bands[r].isNotEmpty) {
                  setState(() => _sel = bands[r].first);
                  widget.onNoteSelected?.call(bands[r].first);
                }
              },
            ),
          ),
        ),
        if (_sel != null) ...[
          const SizedBox(height: 4),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
            decoration: BoxDecoration(border: Border.all(color: NotebookTheme.oxblood)),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Expanded(
                  child: Text('${_sel!.title} (S: ${_sel!.card.stability?.toStringAsFixed(1) ?? "0.0"}d)',
                      style: const TextStyle(fontFamily: 'monospace', fontSize: 10, color: NotebookTheme.ink), overflow: TextOverflow.ellipsis),
                ),
                Text('DUE: ${_sel!.card.due.difference(now).inDays}d', style: const TextStyle(fontFamily: 'monospace', fontSize: 10, color: NotebookTheme.oxblood, fontWeight: FontWeight.bold)),
              ],
            ),
          ),
        ],
      ],
    );
  }
}

class _HorizonPainter extends CustomPainter {
  final List<List<Note>> bands;
  final Note? sel;
  _HorizonPainter(this.bands, this.sel);

  @override
  void paint(Canvas canvas, Size size) {
    final labels = ['DUE/NOW', '1-3d NEAR', '4-14d MID', '15d+ LONG'];
    final rH = size.height / 4;
    final tp = TextPainter(textDirection: TextDirection.ltr);

    for (int i = 0; i < 4; i++) {
      final y = i * rH;
      canvas.drawLine(Offset(60, y + rH / 2), Offset(size.width, y + rH / 2), Paint()..color = NotebookTheme.graphite.withValues(alpha: 0.12));
      tp.text = TextSpan(
        text: labels[i],
        style: TextStyle(fontFamily: 'monospace', fontSize: 7.5, color: i == 0 ? NotebookTheme.oxblood : NotebookTheme.graphite, fontWeight: FontWeight.bold),
      );
      tp.layout();
      tp.paint(canvas, Offset(2, y + (rH - tp.height) / 2));

      final notes = bands[i];
      for (int n = 0; n < notes.length && n < 15; n++) {
        final x = 68.0 + (n * 12.0);
        final isS = sel?.id == notes[n].id;
        final p = Paint()..color = isS ? NotebookTheme.oxblood : (i == 0 ? NotebookTheme.oxblood : NotebookTheme.ink.withValues(alpha: 0.6));
        canvas.drawCircle(Offset(x, y + rH / 2), isS ? 3.5 : 2.0, p);
      }
    }
  }

  @override
  bool shouldRepaint(covariant _HorizonPainter old) => true;
}
</file>

<file path="lib/widgets/visuals/multidimensional_evidence_profile.dart">
import '../../models/evidence_profile_dimension.dart';
import 'dart:math' as math;
import 'package:flutter/material.dart';
import '../../ui/theme_notebook.dart';



class MultidimensionalEvidenceProfile extends StatefulWidget {
  final List<EvidenceProfileDimension> dimensions;
  final double height;
  final ValueChanged<EvidenceProfileDimension>? onDimensionSelected;

  const MultidimensionalEvidenceProfile({
    super.key,
    required this.dimensions,
    this.height = 200,
    this.onDimensionSelected,
  });

  @override
  State<MultidimensionalEvidenceProfile> createState() => _ProfileState();
}

class _ProfileState extends State<MultidimensionalEvidenceProfile> {
  int? _sel;

  @override
  Widget build(BuildContext context) {
    if (widget.dimensions.isEmpty) {
      return SizedBox(
        height: widget.height,
        child: const Center(child: Text('GATHERING EVIDENCE...', style: TextStyle(fontFamily: 'monospace', fontSize: 10, color: NotebookTheme.graphite))),
      );
    }
    final sel = _sel != null && _sel! < widget.dimensions.length ? widget.dimensions[_sel!] : null;
    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        SizedBox(
          height: widget.height,
          child: GestureDetector(
            onTapUp: (d) {
              final box = context.findRenderObject() as RenderBox?;
              if (box == null) return;
              final c = Offset(box.size.width / 2, widget.height / 2);
              final tap = d.localPosition;
              double a = math.atan2(tap.dy - c.dy, tap.dx - c.dx) + (math.pi / 2);
              if (a < 0) a += 2 * math.pi;
              final count = widget.dimensions.length;
              final idx = ((a + math.pi / count) % (2 * math.pi) ~/ (2 * math.pi / count)) % count;
              setState(() => _sel = idx);
              widget.onDimensionSelected?.call(widget.dimensions[idx]);
            },
            child: CustomPaint(
              painter: _Painter(widget.dimensions, _sel),
              size: Size(double.infinity, widget.height),
            ),
          ),
        ),
        if (sel != null) ...[
          const SizedBox(height: 4),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
            decoration: BoxDecoration(border: Border.all(color: NotebookTheme.graphite.withValues(alpha: 0.2))),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Expanded(
                  child: Text('${sel.label.toUpperCase()}: ${sel.detail}', style: const TextStyle(fontFamily: 'monospace', fontSize: 10, color: NotebookTheme.oxblood), overflow: TextOverflow.ellipsis),
                ),
                Text('${(sel.value * 100).round()}%', style: const TextStyle(fontFamily: 'monospace', fontSize: 12, fontWeight: FontWeight.bold, color: NotebookTheme.ink)),
              ],
            ),
          ),
        ],
      ],
    );
  }
}

class _Painter extends CustomPainter {
  final List<EvidenceProfileDimension> dims;
  final int? sel;
  _Painter(this.dims, this.sel);

  @override
  void paint(Canvas canvas, Size size) {
    final c = Offset(size.width / 2, size.height / 2);
    final maxR = math.min(size.width / 2 - 32, size.height / 2 - 12);
    if (maxR <= 0) return;
    final n = dims.length;

    for (int r = 1; r <= 3; r++) {
      final rad = maxR * (r / 3.0);
      final p = Path();
      for (int i = 0; i < n; i++) {
        final a = (i * 2 * math.pi / n) - (math.pi / 2);
        final pt = Offset(c.dx + math.cos(a) * rad, c.dy + math.sin(a) * rad);
        if (i == 0) {
          p.moveTo(pt.dx, pt.dy);
        } else {
          p.lineTo(pt.dx, pt.dy);
        }
      }
      p.close();
      canvas.drawPath(p, Paint()..color = NotebookTheme.graphite.withValues(alpha: 0.1)..style = PaintingStyle.stroke);
    }

    final tp = TextPainter(textDirection: TextDirection.ltr);
    for (int i = 0; i < n; i++) {
      final a = (i * 2 * math.pi / n) - (math.pi / 2);
      canvas.drawLine(c, Offset(c.dx + math.cos(a) * maxR, c.dy + math.sin(a) * maxR), Paint()..color = NotebookTheme.graphite.withValues(alpha: 0.2));
      final isS = sel == i;
      tp.text = TextSpan(
        text: dims[i].label,
        style: TextStyle(fontFamily: 'monospace', fontSize: 8, fontWeight: isS ? FontWeight.bold : FontWeight.normal, color: isS ? NotebookTheme.oxblood : NotebookTheme.graphite),
      );
      tp.layout();
      tp.paint(canvas, Offset(c.dx + math.cos(a) * (maxR + 10) - tp.width / 2, c.dy + math.sin(a) * (maxR + 10) - tp.height / 2));
    }

    final poly = Path();
    final pts = <Offset>[];
    for (int i = 0; i < n; i++) {
      final a = (i * 2 * math.pi / n) - (math.pi / 2);
      final r = maxR * dims[i].value.clamp(0.05, 1.0);
      final pt = Offset(c.dx + math.cos(a) * r, c.dy + math.sin(a) * r);
      pts.add(pt);
      if (i == 0) {
        poly.moveTo(pt.dx, pt.dy);
      } else {
        poly.lineTo(pt.dx, pt.dy);
      }
    }
    poly.close();
    canvas.drawPath(poly, Paint()..color = NotebookTheme.oxblood.withValues(alpha: 0.2)..style = PaintingStyle.fill);
    canvas.drawPath(poly, Paint()..color = NotebookTheme.oxblood..style = PaintingStyle.stroke..strokeWidth = 1.5);
    for (int i = 0; i < pts.length; i++) {
      canvas.drawCircle(pts[i], sel == i ? 3.5 : 2.0, Paint()..color = sel == i ? NotebookTheme.oxblood : NotebookTheme.ink);
    }
  }

  @override
  bool shouldRepaint(covariant _Painter old) => old.dims != dims || old.sel != sel;
}
</file>

<file path="lib/widgets/visuals/performance_density.dart">
import 'package:flutter/material.dart';
import '../../models/learning_attempt.dart';
import '../../ui/theme_notebook.dart';

/// Item 238 — PerformanceDensity.
///
/// Attempts-per-active-day over the last [weeks] weeks. This is the honest
/// "am I actually practising?" view: it counts recorded attempts, not time
/// spent staring at the app, and it makes gaps visible instead of averaging
/// them away the way a single retention percentage would.
class PerformanceDensity extends StatelessWidget {
  final List<LearningAttempt> attempts;
  final int weeks;

  const PerformanceDensity({
    super.key,
    required this.attempts,
    this.weeks = 8,
  });

  /// Returns attempts-per-day for the trailing [weeks] weeks, oldest first.
  /// Days with no attempts are `0`, not skipped.
  static List<({DateTime day, int count})> dailyCounts(
    List<LearningAttempt> attempts, {
    int weeks = 8,
    DateTime? now,
  }) {
    final today = now ?? DateTime.now();
    final end = DateTime(today.year, today.month, today.day);
    final start = end.subtract(Duration(days: weeks * 7 - 1));

    final counts = <String, int>{};
    for (final a in attempts) {
      final d = DateTime(a.timestamp.year, a.timestamp.month, a.timestamp.day);
      if (d.isBefore(start) || d.isAfter(end)) continue;
      final key = '${d.year}-${d.month}-${d.day}';
      counts[key] = (counts[key] ?? 0) + 1;
    }

    final out = <({DateTime day, int count})>[];
    for (int i = 0; i < weeks * 7; i++) {
      final day = start.add(Duration(days: i));
      out.add((day: day, count: counts['${day.year}-${day.month}-${day.day}'] ?? 0));
    }
    return out;
  }

  @override
  Widget build(BuildContext context) {
    final days = dailyCounts(attempts, weeks: weeks);
    final total = days.fold<int>(0, (a, d) => a + d.count);
    final active = days.where((d) => d.count > 0).length;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      mainAxisSize: MainAxisSize.min,
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text('PERFORMANCE DENSITY',
                style: Theme.of(context).textTheme.labelSmall),
            Text('$active / ${weeks * 7} ACTIVE DAYS',
                style: Theme.of(context)
                    .textTheme
                    .labelSmall
                    ?.copyWith(fontSize: 8)),
          ],
        ),
        const SizedBox(height: 6),
        Container(
          padding: const EdgeInsets.all(6),
          decoration: BoxDecoration(
            border:
                Border.all(color: NotebookTheme.graphite.withValues(alpha: 0.2)),
            color: NotebookTheme.paper,
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              for (int w = 0; w < weeks; w++)
                Padding(
                  padding: const EdgeInsets.symmetric(vertical: 1.5),
                  child: Row(
                    children: [
                      for (int d = 0; d < 7; d++)
                        Expanded(
                          child: Padding(
                            padding: const EdgeInsets.symmetric(horizontal: 1),
                            child: _cell(days[w * 7 + d].count),
                          ),
                        ),
                    ],
                  ),
                ),
            ],
          ),
        ),
        const SizedBox(height: 4),
        Text(
          '$total ATTEMPTS IN ${weeks}W · EACH CELL = 1 DAY',
          style: Theme.of(context)
              .textTheme
              .labelSmall
              ?.copyWith(fontSize: 7.5, color: NotebookTheme.graphite),
        ),
      ],
    );
  }

  Widget _cell(int count) {
    if (count == 0) {
      return Container(
        height: 10,
        decoration: BoxDecoration(
          border: Border.all(
              color: NotebookTheme.graphite.withValues(alpha: 0.25),
              width: 0.5),
        ),
      );
    }
    // Saturates at 10 attempts/day; beyond that the difference is noise.
    final intensity = (count / 10).clamp(0.15, 1.0);
    return Container(
      height: 10,
      color: NotebookTheme.oxblood.withValues(alpha: intensity),
    );
  }
}
</file>

<file path="lib/widgets/visuals/prediction_outcome_split.dart">
import 'package:flutter/material.dart';
import '../../models/learning_attempt.dart';
import '../../ui/theme_notebook.dart';

/// Item 234 — PredictionOutcomeSplit.
///
/// Splits every pretest prediction (an attempt made *before* instruction, i.e.
/// `wasPrediction`) against the outcome that followed it. The gap is the
/// prediction error that productive-failure and predictive-processing designs
/// depend on.
///
/// Deliberately reads only fields the app actually records: `confidence` is the
/// prediction (the learner's pre-answer estimate) and `scorePct` is the
/// outcome. Nothing here is fabricated — attempts without both are skipped.
class PredictionOutcomeSplit extends StatelessWidget {
  final List<LearningAttempt> attempts;
  final double height;

  const PredictionOutcomeSplit({
    super.key,
    required this.attempts,
    this.height = 150,
  });

  @override
  Widget build(BuildContext context) {
    final pairs = attempts
        .where((a) => a.confidence != null && !a.scorePct.isNaN)
        .toList();

    final meanGap = pairs.isEmpty
        ? 0.0
        : pairs.fold<double>(
                0.0, (acc, a) => acc + (a.confidence! - a.scorePct)) /
            pairs.length;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      mainAxisSize: MainAxisSize.min,
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text('PREDICTION / OUTCOME SPLIT',
                style: Theme.of(context).textTheme.labelSmall),
            Text(
              pairs.isEmpty
                  ? 'NO PAIRED DATA'
                  : 'MEAN GAP ${meanGap >= 0 ? '+' : ''}${meanGap.toStringAsFixed(1)} PTS',
              style: Theme.of(context).textTheme.labelSmall?.copyWith(
                  fontSize: 8,
                  color: meanGap.abs() > 20
                      ? NotebookTheme.oxblood
                      : NotebookTheme.graphite),
            ),
          ],
        ),
        const SizedBox(height: 6),
        Container(
          height: height,
          decoration: BoxDecoration(
            border:
                Border.all(color: NotebookTheme.graphite.withValues(alpha: 0.2)),
            color: NotebookTheme.paper,
          ),
          child: CustomPaint(
            painter: _SplitPainter(pairs),
            size: Size(double.infinity, height),
          ),
        ),
        const SizedBox(height: 4),
        Text(
          'SOLID = OBSERVED OUTCOME   |   OUTLINE = PREDICTED',
          style: Theme.of(context)
              .textTheme
              .labelSmall
              ?.copyWith(fontSize: 7.5, color: NotebookTheme.graphite),
        ),
      ],
    );
  }
}

class _SplitPainter extends CustomPainter {
  final List<LearningAttempt> pairs;
  _SplitPainter(this.pairs);

  @override
  void paint(Canvas canvas, Size size) {
    if (pairs.isEmpty) {
      final tp = TextPainter(
        text: const TextSpan(
            text: 'NO PREDICTION/OUTCOME PAIRS RECORDED',
            style: TextStyle(
                fontFamily: 'monospace',
                fontSize: 8,
                color: NotebookTheme.graphite)),
        textDirection: TextDirection.ltr,
      )..layout();
      tp.paint(canvas,
          Offset(size.width / 2 - tp.width / 2, size.height / 2 - tp.height / 2));
      return;
    }

    // Most recent 40 pairs, newest on the right.
    final recent = pairs.length > 40 ? pairs.sublist(pairs.length - 40) : pairs;
    final pad = 12.0;
    final w = size.width - pad * 2;
    final h = size.height - pad * 2;
    final slot = w / recent.length;

    final predicted = Paint()
      ..color = NotebookTheme.graphite.withValues(alpha: 0.55)
      ..strokeWidth = 1.0
      ..style = PaintingStyle.stroke;
    final observed = Paint()..color = NotebookTheme.oxblood;

    for (int i = 0; i < recent.length; i++) {
      final a = recent[i];
      final x = pad + slot * (i + 0.5);
      final predictedY = pad + (1 - (a.confidence! / 100).clamp(0.0, 1.0)) * h;
      final observedY = pad + (1 - (a.scorePct / 100).clamp(0.0, 1.0)) * h;

      // The gap itself is the prediction error.
      canvas.drawLine(
          Offset(x, predictedY),
          Offset(x, observedY),
          Paint()
            ..color = NotebookTheme.oxblood.withValues(alpha: 0.25)
            ..strokeWidth = 3.0);

      canvas.drawRect(
          Rect.fromCenter(center: Offset(x, predictedY), width: 7, height: 7),
          predicted);
      canvas.drawCircle(Offset(x, observedY), 3.0, observed);
    }
  }

  @override
  bool shouldRepaint(covariant _SplitPainter old) => old.pairs != pairs;
}
</file>

<file path="lib/widgets/visuals/recovery_curve.dart">
import 'package:flutter/material.dart';
import '../../models/learning_attempt.dart';
import '../../ui/theme_notebook.dart';

/// Item 241 — RecoveryCurve, and item 140 — Recovery measurement.
///
/// Plots retrieval accuracy by minutes-since-session-start. The shape answers
/// the only question the focus system actually cares about: after a break or an
/// interruption, how long until performance returns to its in-session baseline?
///
/// Observational only. There is no sensor here — every point is a real attempt.
class RecoveryCurve extends StatelessWidget {
  final List<LearningAttempt> attempts;
  final double height;

  const RecoveryCurve({
    super.key,
    required this.attempts,
    this.height = 140,
  });

  /// Buckets attempts into 5-minute slots from their session start and returns
  /// the mean score per slot. Sessions with one attempt are ignored because a
  /// curve needs at least a before and an after.
  static List<({int minute, double score, int n})> buckets(
      List<LearningAttempt> attempts) {
    final bySession = <int, List<LearningAttempt>>{};
    for (final a in attempts) {
      final sid = a.sessionId;
      if (sid == null || a.scorePct.isNaN) continue;
      bySession.putIfAbsent(sid, () => []).add(a);
    }

    final sums = <int, double>{};
    final counts = <int, int>{};
    for (final group in bySession.values) {
      if (group.length < 2) continue;
      group.sort((x, y) => x.timestamp.compareTo(y.timestamp));
      final start = group.first.timestamp;
      for (final a in group) {
        final minute = a.timestamp.difference(start).inMinutes;
        final slot = (minute ~/ 5) * 5;
        sums[slot] = (sums[slot] ?? 0) + a.scorePct;
        counts[slot] = (counts[slot] ?? 0) + 1;
      }
    }

    final slots = sums.keys.toList()..sort();
    return [
      for (final s in slots)
        (minute: s, score: sums[s]! / counts[s]!, n: counts[s]!),
    ];
  }

  @override
  Widget build(BuildContext context) {
    final data = buckets(attempts);

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      mainAxisSize: MainAxisSize.min,
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text('RECOVERY CURVE', style: Theme.of(context).textTheme.labelSmall),
            Text('ACCURACY BY ELAPSED MINUTE',
                style: Theme.of(context)
                    .textTheme
                    .labelSmall
                    ?.copyWith(fontSize: 8)),
          ],
        ),
        const SizedBox(height: 6),
        Container(
          height: height,
          decoration: BoxDecoration(
            border:
                Border.all(color: NotebookTheme.graphite.withValues(alpha: 0.2)),
            color: NotebookTheme.paper,
          ),
          child: CustomPaint(
            painter: _RecoveryPainter(data),
            size: Size(double.infinity, height),
          ),
        ),
        const SizedBox(height: 4),
        Text(
          data.isEmpty
              ? 'NOT ENOUGH MULTI-ATTEMPT SESSIONS'
              : '${data.length} 5-MIN BINS FROM OBSERVED ATTEMPTS',
          style: Theme.of(context)
              .textTheme
              .labelSmall
              ?.copyWith(fontSize: 7.5, color: NotebookTheme.graphite),
        ),
      ],
    );
  }
}

class _RecoveryPainter extends CustomPainter {
  final List<({int minute, double score, int n})> data;
  _RecoveryPainter(this.data);

  @override
  void paint(Canvas canvas, Size size) {
    final pad = 16.0;
    final w = size.width - pad * 2;
    final h = size.height - pad * 2;
    if (w <= 0 || h <= 0) return;

    // Grid at 0/50/100.
    for (final frac in [0.0, 0.5, 1.0]) {
      final y = pad + frac * h;
      canvas.drawLine(
        Offset(pad, y),
        Offset(pad + w, y),
        Paint()
          ..color = NotebookTheme.graphite.withValues(alpha: 0.12)
          ..strokeWidth = 1.0,
      );
    }

    if (data.isEmpty) {
      final tp = TextPainter(
        text: const TextSpan(
            text: 'NO RECOVERY DATA RECORDED',
            style: TextStyle(
                fontFamily: 'monospace',
                fontSize: 8,
                color: NotebookTheme.graphite)),
        textDirection: TextDirection.ltr,
      )..layout();
      tp.paint(canvas,
          Offset(size.width / 2 - tp.width / 2, size.height / 2 - tp.height / 2));
      return;
    }

    final maxMinute = data.last.minute == 0 ? 1 : data.last.minute;
    Offset pointFor(({int minute, double score, int n}) d) => Offset(
          pad + (d.minute / maxMinute) * w,
          pad + (1 - (d.score / 100).clamp(0.0, 1.0)) * h,
        );

    final path = Path()..moveTo(pointFor(data.first).dx, pointFor(data.first).dy);
    for (final d in data.skip(1)) {
      final p = pointFor(d);
      path.lineTo(p.dx, p.dy);
    }

    canvas.drawPath(
      path,
      Paint()
        ..color = NotebookTheme.oxblood
        ..strokeWidth = 1.6
        ..style = PaintingStyle.stroke,
    );

    for (final d in data) {
      canvas.drawCircle(pointFor(d), 2.5 + (d.n.clamp(0, 5) * 0.4),
          Paint()..color = NotebookTheme.oxblood);
    }
  }

  @override
  bool shouldRepaint(covariant _RecoveryPainter old) => old.data != data;
}
