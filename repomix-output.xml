            Text('LONGEST BLOCK: ${unbrokenMin}m | $interruptions BREAKS', style: Theme.of(context).textTheme.labelSmall?.copyWith(fontSize: 8)),
          ],
        ),
        const SizedBox(height: 6),
        Container(
          height: 18,
          decoration: BoxDecoration(
