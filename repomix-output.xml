    final note1 = Note(
      id: 1,
      title: 'Anchor Note A',
      body: 'Concept A body',
      kind: NoteKind.blurtSummary,
      createdAt: now,
      updatedAt: now,
      card: fsrs.Card(cardId: 1),
    );
    final note2 = Note(
      id: 2,
      title: 'Interleaved Note B',
