import 'learning_enums.dart';

/// Structured error taxonomy (§12).
///
/// Deliberately a closed enum, not free text: recurrence analytics ("do I keep
/// making this *kind* of mistake?") is impossible over prose, and the whole
/// point of diagnosis is to pick a different intervention, which requires a
/// stable key to branch on.
enum ErrorType {
  conceptualMisunderstanding,
  factualRecallFailure,
  retrievalFailure,
  formulaFailure,
  wrongMethod,
  wrongAssumption,
  calculationError,
  logicalError,
  misread,
  carelessError,
  confusedConcepts,
  incompleteReasoning,
  guessed,
  timePressure,
  unknown;

  String get label => switch (this) {
        ErrorType.conceptualMisunderstanding => 'Conceptual misunderstanding',
        ErrorType.factualRecallFailure => 'Factual recall failure',
        ErrorType.retrievalFailure => 'Knew it but could not retrieve it',
        ErrorType.formulaFailure => 'Formula failure',
        ErrorType.wrongMethod => 'Wrong method',
        ErrorType.wrongAssumption => "Wrong assumption",
        ErrorType.calculationError => 'Calculation error',
        ErrorType.logicalError => 'Logical error',
        ErrorType.misread => 'Misread the question',
        ErrorType.carelessError => 'Careless error',
        ErrorType.confusedConcepts => 'Confused two concepts',
        ErrorType.incompleteReasoning => 'Incomplete reasoning',
        ErrorType.guessed => 'Guessed',
        ErrorType.timePressure => 'Ran out of time',
        ErrorType.unknown => 'Unknown',
      };

  /// Which intervention this error family suggests. Consumed by
  /// InterventionEngine — kept beside the taxonomy so the mapping is auditable
  /// in one place instead of scattered through the UI.
  ErrorFamily get family => switch (this) {
        ErrorType.conceptualMisunderstanding => ErrorFamily.conceptual,
        ErrorType.confusedConcepts => ErrorFamily.conceptual,
        ErrorType.wrongAssumption => ErrorFamily.conceptual,
        ErrorType.logicalError => ErrorFamily.conceptual,
        ErrorType.wrongMethod => ErrorFamily.procedural,
        ErrorType.formulaFailure => ErrorFamily.procedural,
        ErrorType.calculationError => ErrorFamily.procedural,
        ErrorType.incompleteReasoning => ErrorFamily.procedural,
        ErrorType.factualRecallFailure => ErrorFamily.retrieval,
        ErrorType.retrievalFailure => ErrorFamily.retrieval,
        ErrorType.guessed => ErrorFamily.retrieval,
        ErrorType.misread => ErrorFamily.attention,
        ErrorType.carelessError => ErrorFamily.attention,
        ErrorType.timePressure => ErrorFamily.attention,
        ErrorType.unknown => ErrorFamily.unknown,
      };

  /// Self-diagnosis options offered to the learner after a failure (§14),
  /// in the order the UI shows them. `unknown` is intentionally absent — the
  /// learner picks "Other" which maps to it via [fromSelfDiagnosisLabel].
  static const List<ErrorType> selfDiagnosisOptions = [
    ErrorType.factualRecallFailure,
    ErrorType.retrievalFailure,
    ErrorType.wrongMethod,
    ErrorType.misread,
    ErrorType.confusedConcepts,
    ErrorType.calculationError,
    ErrorType.guessed,
    ErrorType.timePressure,
    ErrorType.carelessError,
  ];

  /// Maps the plain-language self-diagnosis strings to the taxonomy. Anything
  /// unrecognised becomes [ErrorType.unknown] rather than throwing — a free-text
  /// answer must never break the flow.
  static ErrorType fromSelfDiagnosisLabel(String label) {
    final l = label.trim().toLowerCase();
    if (l.isEmpty) return ErrorType.unknown;
    for (final e in ErrorType.values) {
      if (e.label.toLowerCase() == l) return e;
    }
    if (l.contains('didn\'t know') || l.contains('did not know')) {
      return ErrorType.factualRecallFailure;
    }
    if (l.contains('couldn\'t retrieve') || l.contains('knew it')) {
      return ErrorType.retrievalFailure;
    }
    if (l.contains('method')) return ErrorType.wrongMethod;
    if (l.contains('underst')) return ErrorType.conceptualMisunderstanding;
    if (l.contains('confus')) return ErrorType.confusedConcepts;
    if (l.contains('calculat')) return ErrorType.calculationError;
    if (l.contains('guess')) return ErrorType.guessed;
    if (l.contains('time')) return ErrorType.timePressure;
    if (l.contains('careless')) return ErrorType.carelessError;
    if (l.contains('misread')) return ErrorType.misread;
    return ErrorType.unknown;
  }

  static ErrorType? tryParse(String? name) {
    if (name == null) return null;
    for (final v in ErrorType.values) {
      if (v.name == name) return v;
    }
    return null;
  }
}

/// Coarse grouping used for intervention selection. Two errors in the same
/// family suggest the same next action, which is what makes the policy engine
/// stable across subjects.
enum ErrorFamily { conceptual, procedural, retrieval, attention, unknown }

/// One diagnosed error attached to one attempt.
///
/// Multiple errors per attempt are allowed (§12) and the learner is never
/// forced to pick one. The three sources stay separable so diagnostic
/// calibration (user said X, deterministic evidence said Y) is measurable.
class ErrorRecord {
  final int id;
  final int attemptId;
  final ErrorType type;
  final DiagnosisSource source;

  /// 0..1. Produced by the classifier; `user` source freely reports 1.0.
  final double confidence;

  /// Short human-readable justification ("3 of 9 concepts recalled", or the
  /// model's one-line reason). Bounded in length by the producers.
  final String evidence;

  final DateTime createdAt;
  final int? confusedConceptId;

  const ErrorRecord({
    required this.id,
    required this.attemptId,
    required this.type,
    required this.source,
    this.confidence = 1.0,
    this.evidence = '',
    required this.createdAt,
    this.confusedConceptId,
  });

  ErrorFamily get family => type.family;

  /// Alias for self-diagnosed error category from user source.
  ErrorType get selfDiagnosedCategory =>
      source == DiagnosisSource.user ? type : ErrorType.unknown;

  /// Alias for system-diagnosed error category from non-user source.
  ErrorType get systemDiagnosedCategory =>
      source != DiagnosisSource.user ? type : ErrorType.unknown;

  /// Requires a paired record on the same attemptId from a different source; this single record cannot detect disagreement on its own. Use `FeedbackDiagnosisService.compareDiagnosis` for that.
  bool get isDisagreement => false;
}

/// Typedef alias for ErrorType.
typedef CognitiveErrorCategory = ErrorType;
</file>

<file path="lib/models/experiment.dart">
import 'intervention.dart';
import 'learning_enums.dart';

/// How much a comparison can actually support a causal claim (§29).
///
/// This is a first-class field, not a comment, because the UI must never label
/// an observational comparison as if it were controlled.
enum ComparisonQuality {
  controlled, // randomised assignment within a comparable population
  quasiControlled, // matched post-hoc on measurable covariates
  observational; // no control at all — association only

  String get label => switch (this) {
        ComparisonQuality.controlled => 'controlled (randomised)',
        ComparisonQuality.quasiControlled => 'quasi-controlled (matched)',
        ComparisonQuality.observational => 'observational (no control)',
      };

  /// Whether the system is allowed to phrase this as an effect of the
  /// intervention rather than a correlation with it.
  bool get supportsCausalClaim => this == ComparisonQuality.controlled;

  static ComparisonQuality? tryParse(String? name) {
    if (name == null) return null;
    for (final v in ComparisonQuality.values) {
      if (v.name == name) return v;
    }
    return null;
  }
}

/// One arm of an experiment (§28).
class ExperimentCondition {
  /// Stable key, used in the assignment hash. Never a display label.
  final String key;
  final String label;
  final InterventionAction action;

  const ExperimentCondition({
    required this.key,
    required this.label,
    required this.action,
  });
}

/// A personal experiment: does intervention B beat A *for this learner*, on a
/// delayed measure (§28).
class Experiment {
  final int id;
  final String hypothesis;
  final List<ExperimentCondition> conditions;

  /// Which delay buckets count as the outcome. Defaults to medium+long.
  final Set<DelayBucket> outcomeBuckets;

  final int? targetConceptTypeFilter; // ConceptType.index, null = any

  /// Minimum attempts per condition before any difference is reported at all.
  final int minAttemptsPerCondition;

  final DateTime startedAt;
  final DateTime? endedAt;
  final bool active;

  const Experiment({
    required this.id,
    required this.hypothesis,
    required this.conditions,
    this.outcomeBuckets = const {
      DelayBucket.mediumDelay,
      DelayBucket.longDelay,
      DelayBucket.transfer,
    },
    this.targetConceptTypeFilter,
    this.minAttemptsPerCondition = 4,
    required this.startedAt,
    this.endedAt,
    this.active = true,
  });

  ExperimentCondition? conditionByKey(String key) {
    for (final c in conditions) {
      if (c.key == key) return c;
    }
    return null;
  }

  ConceptType? get conceptTypeFilter {
    final i = targetConceptTypeFilter;
    if (i == null || i < 0 || i >= ConceptType.values.length) return null;
    return ConceptType.values[i];
  }

  /// A single-condition experiment cannot compare anything — guard so callers
  /// cannot accidentally create a "study" and read an effect out of it.
  bool get isComparable => conditions.length >= 2;

  /// Returns key timeline events for an experiment.
  static List<({DateTime at, String label})> timelineEvents(Experiment e) => [
        (at: e.startedAt, label: 'started'),
        if (e.endedAt != null) (at: e.endedAt!, label: 'ended'),
      ];

  /// Baseline accuracy for a specific condition within a comparison.
  static double? baselineAccuracy(
    ExperimentComparison c,
    String conditionKey,
  ) =>
      c.resultFor(conditionKey)?.delayedAccuracy;

  /// Single sentence summarizing the outcome of a comparison.
  static String outcomeSummary(ExperimentComparison c) {
    if (c.underpowered) {
      return 'Experiment is currently underpowered with insufficient delayed measurements (${c.quality.label}).';
    }
    final delta = c.delayedDelta;
    final deltaStr = delta != null
        ? '${delta >= 0 ? "+" : ""}${delta.toStringAsFixed(1)}%'
        : 'no delta';
    return 'Comparison quality is ${c.quality.label} with delayed retention delta of $deltaStr.';
  }

  /// Difference in delayed retention delta from comparison.
  static double? delayedRetentionDelta(ExperimentComparison c) =>
      c.delayedDelta;
}

/// Measured result for one condition of one experiment.
class ConditionResult {
  final String conditionKey;
  final int delayedAttempts;
  final int successes;

  /// Mean score across the *delayed* attempts only.
  final double meanDelayedScore;

  /// Mean score across all immediate attempts in this condition — reported
  /// separately because an intervention that lifts immediate performance while
  /// leaving delayed performance flat has not achieved the goal (§30).
  final double meanImmediateScore;
  final int immediateAttempts;

  const ConditionResult({
    required this.conditionKey,
    required this.delayedAttempts,
    required this.successes,
    required this.meanDelayedScore,
    required this.meanImmediateScore,
    required this.immediateAttempts,
  });

  double get delayedAccuracy =>
      delayedAttempts == 0 ? 0 : successes / delayedAttempts;
}

/// Full comparison across conditions, with an explicit quality label.
class ExperimentComparison {
  final Experiment experiment;
  final List<ConditionResult> results;
  final ComparisonQuality quality;

  /// Why the quality label is what it is (shown to the user verbatim).
  final String qualityReason;

  /// Difference in delayed mean score between the first two conditions
  /// (condition[1] - condition[0]). Null when underpowered.
  final double? delayedDelta;

  /// Sample size guard: below `minAttemptsPerCondition` per arm, no delta is
  /// reported at all.
  final bool underpowered;

  const ExperimentComparison({
    required this.experiment,
    required this.results,
    required this.quality,
    required this.qualityReason,
    this.delayedDelta,
    this.underpowered = true,
  });

  ConditionResult? resultFor(String key) {
    for (final r in results) {
      if (r.conditionKey == key) return r;
    }
    return null;
  }
}
</file>

<file path="lib/models/feedback_record.dart">
import 'learning_enums.dart';

/// Corrective feedback for one attempt (§11).
///
/// Deliberately fielded rather than a prose blob: the four questions the
/// learner actually needs answered (what was right / missing / wrong / next)
/// are separate so the UI can show them tersely and the analytics can track
/// which one recurs. AI may *fill* these fields; it does not own the shape.
class FeedbackRecord {
  final int id;
  final int attemptId;
  final DateTime createdAt;

  /// How the attempt was judged. Kept as the authoritative grade for the
  /// attempt — `LearningAttempt.correctness` mirrors it.
  final Correctness correctness;

  /// 0..100. For free recall this is the evaluator's semantic score; for a
  /// self-explanation it is the reasoning rubric score.
  final double scorePct;

  /// What the learner got right. Bounded list, not prose.
  final List<String> correctPoints;

  /// Concepts/steps that should have been present and were not.
  final List<String> missing;

  /// Statements that are actively wrong (as opposed to absent) — only ever
  /// populated when the evaluator can point at something specific.
  final List<String> incorrect;

  /// One actionable next step ("retrieve the 3 layers again in ~10 min").
  /// At most one: §11 says do not expose excessive AI prose.
  final String nextAction;

  /// True when this came from AI rather than the deterministic scorer, so
  /// analytics never blur the two.
  final bool fromAi;

  const FeedbackRecord({
    required this.id,
    required this.attemptId,
    required this.createdAt,
    required this.correctness,
    required this.scorePct,
    this.correctPoints = const [],
    this.missing = const [],
    this.incorrect = const [],
    this.nextAction = '',
    this.fromAi = false,
  });

  bool get isEmpty =>
      correctPoints.isEmpty &&
      missing.isEmpty &&
      incorrect.isEmpty &&
      nextAction.isEmpty;
}
</file>

<file path="lib/models/focus_integrity.dart">
/// Session-level attention measurements (§26).
///
/// Only records what the app can actually observe on the platform. There is no
/// "focus score" here and there never should be: interruptions are counted from
/// real app lifecycle events, task switches from real wizard navigations.
class FocusIntegrity {
  final int? sessionId;

  /// What the learner (or the policy) intended the session to run for.
  /// Null when no plan was set — not a fabricated default.
  final Duration? plannedDuration;

  /// Wall clock from session start to completion/abandonment.
  final Duration actualDuration;

  /// App went to background during the session.
  final int interruptions;

  /// Wizard steps visited more than once, or target changes mid-session.
  final int taskSwitches;

  final bool abandoned;
  final bool completed;

  /// Longest unbroken foreground stretch, in ms. Null when never tracked.
  final int? longestFocusMs;

  const FocusIntegrity({
    this.sessionId,
    this.plannedDuration,
    this.actualDuration = Duration.zero,
    this.interruptions = 0,
    this.taskSwitches = 0,
    this.abandoned = false,
    this.completed = false,
    this.longestFocusMs,
  });

  /// Fraction of the plan actually delivered, clamped to 0..1. Null when no
  /// plan existed — an unplanned session is not a 0% session.
  double? get completionRatio {
    final plan = plannedDuration;
    if (plan == null || plan.inMilliseconds <= 0) return null;
    return (actualDuration.inMilliseconds / plan.inMilliseconds).clamp(0.0, 1.0);
  }

  /// Interruptions per 10 minutes of actual work. Null for zero-length sessions
  /// (division would be meaningless, not zero).
  double? get interruptionRate {
    if (actualDuration.inSeconds < 60) return null;
    return interruptions / (actualDuration.inMilliseconds / 600000);
  }

  FocusIntegrity copyWith({
    int? sessionId,
    Duration? plannedDuration,
    Duration? actualDuration,
    int? interruptions,
    int? taskSwitches,
    bool? abandoned,
    bool? completed,
    int? longestFocusMs,
  }) =>
      FocusIntegrity(
        sessionId: sessionId ?? this.sessionId,
        plannedDuration: plannedDuration ?? this.plannedDuration,
        actualDuration: actualDuration ?? this.actualDuration,
        interruptions: interruptions ?? this.interruptions,
        taskSwitches: taskSwitches ?? this.taskSwitches,
        abandoned: abandoned ?? this.abandoned,
        completed: completed ?? this.completed,
        longestFocusMs: longestFocusMs ?? this.longestFocusMs,
      );
}

/// Typedef alias for FocusIntegrity.
typedef FocusIntegrityRecord = FocusIntegrity;
</file>

<file path="lib/models/knowledge_evidence.dart">
import 'error_record.dart';

/// Explainable state of a knowledge target (§33).
///
/// There is deliberately no `knowledgeScore = 82`. A single number collapses
/// six different kinds of evidence into one figure that cannot be argued with;
/// this enum is derived *from* those six counts and always ships with the
/// counts that produced it, so the label is falsifiable.
enum KnowledgeState {
  unknown, // no evidence at all
  developing, // some evidence, not yet reliable
  probable, // consistent success, but only immediate / single-mode
  verified, // repeated success across more than one mode
  stable, // delayed success sustained over time
  unstable, // was strong, recent evidence regressed
  bottleneck; // weak *and* blocking other targets in the graph

  String get label => switch (this) {
        KnowledgeState.unknown => 'Unknown',
        KnowledgeState.developing => 'Developing',
        KnowledgeState.probable => 'Probable',
        KnowledgeState.verified => 'Verified',
        KnowledgeState.stable => 'Stable',
        KnowledgeState.unstable => 'Unstable',
        KnowledgeState.bottleneck => 'Bottleneck',
      };
}

/// The evidence counts behind a [KnowledgeState]. Every field is a count or a
/// measured value from the evidence tables — nothing here is inferred or
/// weighted. "Explainable state" means exactly this: you can print the object.
class EvidenceSummary {
  final int retrievalAttempts;
  final int retrievalSuccesses;
  final int delayedAttempts;
  final int delayedSuccesses;
  final int applicationAttempts;
  final int applicationSuccesses;
  final int transferAttempts;
  final int transferSuccesses;
  final int explanationAttempts;

  /// Records where correctness was `unknown` — evaluated as "no evidence"
  /// rather than folded in as failures.
  final int unknownOutcomes;

  /// Mean calibration error across attempts that had both a confidence
  /// judgment and a score. Null when never measured.
  final double? meanCalibrationError;

  /// Most recent conceptual-family error, if any (used for the unstable /
  /// bottleneck distinctions).
  final ErrorType? lastConceptualError;

  /// How many other targets link to this one in the knowledge graph.
  final int dependents;

  const EvidenceSummary({
    this.retrievalAttempts = 0,
    this.retrievalSuccesses = 0,
    this.delayedAttempts = 0,
    this.delayedSuccesses = 0,
    this.applicationAttempts = 0,
    this.applicationSuccesses = 0,
    this.transferAttempts = 0,
    this.transferSuccesses = 0,
    this.explanationAttempts = 0,
    this.unknownOutcomes = 0,
    this.meanCalibrationError,
    this.lastConceptualError,
    this.dependents = 0,
  });

  int get totalAttempts =>
      retrievalAttempts + applicationAttempts + transferAttempts + explanationAttempts;

  int get totalSuccesses =>
      retrievalSuccesses + applicationSuccesses + transferSuccesses;

  double? get retrievalAccuracy =>
      retrievalAttempts == 0 ? null : retrievalSuccesses / retrievalAttempts;

  double? get applicationAccuracy =>
      applicationAttempts == 0 ? null : applicationSuccesses / applicationAttempts;

  double? get transferAccuracy =>
      transferAttempts == 0 ? null : transferSuccesses / transferAttempts;

  double? get delayedAccuracy =>
      delayedAttempts == 0 ? null : delayedSuccesses / delayedAttempts;

  /// How many distinct modes have at least one success. `>= 2` is what
  /// separates probable from verified.
  int get successfulModes {
    var n = 0;
    if (retrievalSuccesses > 0) n++;
    if (applicationSuccesses > 0) n++;
    if (transferSuccesses > 0) n++;
    if (explanationAttempts > 0 && retrievalSuccesses > 0) n++;
    return n;
  }

  bool get isOverconfident =>
      meanCalibrationError != null && meanCalibrationError! > 20;

  bool get isUnderconfident =>
      meanCalibrationError != null && meanCalibrationError! < -20;
}

/// A state plus the evidence that produced it — the only shape the UI should
/// ever consume when it needs to say "how well do I know this?".
class KnowledgeEvidence {
  final int knowledgeTargetId;
  final KnowledgeState state;
  final EvidenceSummary evidence;

  /// One-sentence justification assembled from the counts, e.g.
  /// "8 retrieval attempts, 6 delayed successes, 3 application successes".
  final String rationale;

  /// 0..1 how much to trust [state]. Grows with evidence *breadth*, never
  /// invented: no evidence -> 0.
  final double confidence;

  const KnowledgeEvidence({
    required this.knowledgeTargetId,
    required this.state,
    required this.evidence,
    required this.rationale,
    required this.confidence,
  });

  bool get isActionable =>
      state == KnowledgeState.unstable ||
      state == KnowledgeState.bottleneck ||
      state == KnowledgeState.developing;
}
</file>

<file path="lib/models/learning_attempt.dart">
import 'learning_enums.dart';

/// One meaningful learning attempt (§8).
///
/// This is the durable evidence atom: what target, what operation, what came
/// out, how confident the learner was, how long it took. Everything downstream
/// (feedback, errors, interventions, scheduling, analytics, experiments) keys
/// off [id].
///
/// Nullable fields are limited to those that genuinely may not exist (an
/// unmeasured response time, a cold-start attempt with no note yet). Where the
/// shape differs by mode, use [respondsWithText] / [extras] rather than adding
/// more nullable columns — the alternative was a 14-field all-nullable row.
class LearningAttempt {
  final int id;
  final DateTime timestamp;

  /// The concept being exercised. `null` only for a cold-start blurt that has
  /// not yet been promoted to a note.
  final int? knowledgeTargetId;
  final int? sessionId;

  final TestType testType;
  final String response;
  final Correctness correctness;

  /// 0..100 continuous credit — the same scale as `BlurtScore.scorePct` so old
  /// and new history are directly comparable. NaN = no evidence.
  final double scorePct;

  final int? responseTimeMs;

  /// 0..100 pre-answer confidence judgment, or null when not asked (§13).
  final int? confidence;

  final double? difficulty;

  /// Free-form, bounded extras (cues given, contrast pair, pretest prediction,
  /// which worked-example step was faded...). Kept as a map so the schema does
  /// not need a migration per feature.
  final Map<String, String> extras;

  // Produced after evaluation; linked rather than embedded so each artefact
  // keeps its own record and can be independently replaced/audited.
  final int? feedbackId;
  final List<int> errorIds;
  final int? interventionId;
  final int? delayedOutcomeId;

  /// Was this part of an interleaved block, and why (audit §8: the existing
  /// `wasInterleaved` column was written but never true).
  final bool wasInterleaved;
  final String? interleaveGroupId;
  final String? interleaveReason;

  /// When this attempt measures something first acquired, this is the origin
  /// time used to derive the [DelayBucket]. Null = not a delayed measurement.
  final DateTime? acquiredAt;

  const LearningAttempt({
    required this.id,
    required this.timestamp,
    this.knowledgeTargetId,
    this.sessionId,
    required this.testType,
    this.response = '',
    required this.correctness,
    this.scorePct = double.nan,
    this.responseTimeMs,
    this.confidence,
    this.difficulty,
    this.extras = const {},
    this.feedbackId,
    this.errorIds = const [],
    this.interventionId,
    this.delayedOutcomeId,
    this.wasInterleaved = false,
    this.interleaveGroupId,
    this.interleaveReason,
    this.acquiredAt,
  });

  bool get hasEvidence => !scorePct.isNaN;

  /// Alias for [responseTimeMs].
  int? get latencyMs => responseTimeMs;

  /// Alias for [scorePct].
  double get accuracyScore => scorePct;

  /// Alias for [confidence].
  int? get confidenceRating => confidence;

  /// Alias for [scorePct].
  double get immediateRecallRate => scorePct;

  /// Deterministic delay bucket for this attempt (§24). Transfer attempts win
  /// outright — they are measured for a different reason, not a different time.
  DelayBucket get delayBucket {
    if (testType == TestType.transfer) return DelayBucket.transfer;
    final origin = acquiredAt;
    if (origin == null) return DelayBucket.immediate;
    return DelayBucket.fromElapsed(timestamp.difference(origin));
  }

  bool get isDelayed => delayBucket.isDelayed;

  /// Calibration error in confidence points: positive = overconfident.
  /// NaN when either side is missing — callers must not treat that as zero.
  double get calibrationError {
    final c = confidence;
    if (c == null || scorePct.isNaN) return double.nan;
    return c - scorePct;
  }

  bool get respondsWithText => response.isNotEmpty;

  LearningAttempt copyWith({
    int? id,
    int? feedbackId,
    List<int>? errorIds,
    int? interventionId,
    int? delayedOutcomeId,
  }) =>
      LearningAttempt(
        id: id ?? this.id,
        timestamp: timestamp,
        knowledgeTargetId: knowledgeTargetId,
        sessionId: sessionId,
        testType: testType,
        response: response,
        correctness: correctness,
        scorePct: scorePct,
        responseTimeMs: responseTimeMs,
        confidence: confidence,
        difficulty: difficulty,
        extras: extras,
        feedbackId: feedbackId ?? this.feedbackId,
        errorIds: errorIds ?? this.errorIds,
        interventionId: interventionId ?? this.interventionId,
        delayedOutcomeId: delayedOutcomeId ?? this.delayedOutcomeId,
        wasInterleaved: wasInterleaved,
        interleaveGroupId: interleaveGroupId,
        interleaveReason: interleaveReason,
        acquiredAt: acquiredAt,
      );
}
</file>

<file path="lib/models/learning_enums.dart">
/// Discriminator for *how* knowledge was exercised.
///
/// The audit (§4) found the old model conflated every attempt into one shape
/// (`BlurtScore` = always FREE_RECALL). Recall, application, explanation and
/// transfer are separate skills that decay at different rates and must stay
/// separable in analytics — so the operation is now a first-class field, not
/// an assumption.
///
/// Ranking of "strength of evidence" is intentionally NOT encoded here; that
/// lives in LearningEvidenceService where it can be argued about in one place.
enum TestType {
  freeRecall, // blurt: source hidden, unconstrained retrieval
  cuedRecall, // prompt/cue given, answer retrieved
  application, // use the concept in a novel situation
  explanation, // self-explanation: why is this true / why does this step follow
  reconstruction, // rebuild a structure from partial cues (worked-example fading)
  discrimination, // distinguish A from B (contrastive, needs a graph relation)
  pretest, // attempt before instruction, to surface prior knowledge
  workedExample, // study a fully worked solution (not scored as retrieval)
  transfer, // structurally different problem, same underlying principle
}

/// Human label for UI; kept generic (no subject assumptions).
extension TestTypeLabel on TestType {
  String get label => switch (this) {
        TestType.freeRecall => 'Free recall',
        TestType.cuedRecall => 'Cued recall',
        TestType.application => 'Application',
        TestType.explanation => 'Explanation',
        TestType.reconstruction => 'Reconstruction',
        TestType.discrimination => 'Discrimination',
        TestType.pretest => 'Pre-test',
        TestType.workedExample => 'Worked example',
        TestType.transfer => 'Transfer',
      };

  /// True when the learner must *produce* an answer from memory/understanding
  /// rather than study one. Only productive attempts yield retrieval evidence
  /// (worked examples are instruction, not evidence).
  bool get isProductive => this != TestType.workedExample;
}

/// How long after acquisition an outcome was measured.
///
/// §24: a concept is stronger on *repeated delayed* evidence, not one immediate
/// success. The bucket is derived deterministically from elapsed time, never
/// self-reported.
enum DelayBucket {
  immediate, // < 1 hour
  shortDelay, // < 1 day
  mediumDelay, // < 7 days
  longDelay, // >= 7 days
  transfer; // measured via a transfer-type attempt (orthogonal, wins outright)

  static DelayBucket? tryParse(String? val) {
    if (val == null) return null;
    for (final v in DelayBucket.values) {
      if (v.name == val) return v;
    }
    return null;
  }

  static DelayBucket fromElapsed(Duration elapsed) {
    if (elapsed.inMinutes < 60) return DelayBucket.immediate;
    if (elapsed.inHours < 24) return DelayBucket.shortDelay;
    if (elapsed.inDays < 7) return DelayBucket.mediumDelay;
    return DelayBucket.longDelay;
  }

  String get label => switch (this) {
        DelayBucket.immediate => 'immediate',
        DelayBucket.shortDelay => 'short delay (same day)',
        DelayBucket.mediumDelay => 'medium delay (1-6 days)',
        DelayBucket.longDelay => 'long delay (7+ days)',
        DelayBucket.transfer => 'transfer',
      };

  /// Delayed buckets are the ones that actually predict durable learning.
  bool get isDelayed => this == DelayBucket.mediumDelay ||
      this == DelayBucket.longDelay ||
      this == DelayBucket.transfer;
}

/// Structured outcome of one attempt.
///
/// `unknown` exists because "no evidence" must never be silently converted
/// into "zero" (§32) — a free recall with an unavailable evaluator is unknown,
/// not a failure.
enum Correctness {
  correct,
  partiallyCorrect,
  incorrect,
  incomplete,
  contradictory,
  unknown;

  /// 0..1 deterministic credit for a grade. `unknown` contributes no evidence.
  /// Returns NaN for unknown so callers must handle it explicitly rather than
  /// accidentally averaging a 0 in.
  double get credit => switch (this) {
        Correctness.correct => 1.0,
        Correctness.partiallyCorrect => 0.5,
        Correctness.incomplete => 0.5,
        Correctness.incorrect => 0.0,
        Correctness.contradictory => 0.0,
        Correctness.unknown => double.nan,
      };

  bool get isFail => this == Correctness.incorrect ||
      this == Correctness.contradictory ||
      this == Correctness.incomplete;

  /// Deterministic banding of a 0..100 semantic score. Thresholds are shared
  /// with `FeedbackEngine` so a score never means two different things.
  static Correctness fromScorePct(double pct) {
    if (pct.isNaN) return Correctness.unknown;
    if (pct >= 85) return Correctness.correct;
    if (pct >= 50) return Correctness.partiallyCorrect;
    if (pct > 0) return Correctness.incomplete;
    return Correctness.incorrect;
  }

  static Correctness? tryParse(String? name) {
    if (name == null) return null;
    for (final v in Correctness.values) {
      if (v.name == name) return v;
    }
    return null;
  }
}

/// Who produced a diagnosis. §12: user, deterministic and AI signals are
/// stored separately so they can be *compared*, not merged into one truth.
enum DiagnosisSource {
  user,
  deterministic,
  ai;

  static DiagnosisSource? tryParse(String? name) {
    if (name == null) return null;
    for (final v in DiagnosisSource.values) {
      if (v.name == name) return v;
    }
    return null;
  }
}

/// What kind of thing the learner was working on. §31: the *most effective*
/// intervention may differ by target type; the system should find that out per
/// learner rather than hard-coding it.
enum ConceptType {
  definition,
  procedure,
  algorithm,
  relationship,
  discrimination,
  problemSolving,
  formula,
  conceptualModel,
  unclassified;

  static ConceptType? tryParse(String? name) {
    if (name == null) return null;
    for (final v in ConceptType.values) {
      if (v.name == name) return v;
    }
    return null;
  }

  String get label => switch (this) {
        ConceptType.definition => 'Definition',
        ConceptType.procedure => 'Procedure',
        ConceptType.algorithm => 'Algorithm',
        ConceptType.relationship => 'Relationship',
        ConceptType.discrimination => 'Discrimination',
        ConceptType.problemSolving => 'Problem solving',
        ConceptType.formula => 'Formula',
        ConceptType.conceptualModel => 'Conceptual model',
        ConceptType.unclassified => 'Unclassified',
      };
}

/// Typedef alias for TestType.
typedef LearningAttemptType = TestType;
