      // 5 links out of 9 possible = ~55.6%.
      expect(result.crossLinkDensity, closeTo(55.6, 0.1));
    });

    test('computes retention over time', () {
      final prev = BlurtScore(
        id: 1,
        noteId: 1,
        noteTitle: 'Test',
        date: DateTime.now().subtract(const Duration(days: 7)),
        scorePct: 60,
        matched: ['a'],
        missed: ['b'],
